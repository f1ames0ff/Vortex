<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>VortexFomodHost</AssemblyName>
    <RootNamespace>VortexFomodHost</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="FomodInstaller.Interface">
      <HintPath>$(FomodInstallerDir)/FomodInstaller.Interface.dll</HintPath>
    </Reference>
    <Reference Include="ModInstaller.Adaptor.Dynamic">
      <HintPath>$(FomodInstallerDir)/ModInstaller.Adaptor.Dynamic.dll</HintPath>
    </Reference>
    <Reference Include="Scripting">
      <HintPath>$(FomodInstallerDir)/Scripting.dll</HintPath>
    </Reference>
    <Reference Include="XmlScript">
      <HintPath>$(FomodInstallerDir)/XmlScript.dll</HintPath>
    </Reference>
    <Reference Include="CSharpScript">
      <HintPath>$(FomodInstallerDir)/CSharpScript.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis">
      <HintPath>$(FomodInstallerDir)/Microsoft.CodeAnalysis.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp">
      <HintPath>$(FomodInstallerDir)/Microsoft.CodeAnalysis.CSharp.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="fixtures/**" />
    <Compile Remove="tests/**" />
    <None Include="fixtures/**" />
    <None Include="$(FomodInstallerDir)/*.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
