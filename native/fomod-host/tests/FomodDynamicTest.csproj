<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../HostSource.cs" Link="HostSource.cs" />
    <Reference Include="FomodInstaller.Interface">
      <HintPath>$(FomodInstallerDir)/FomodInstaller.Interface.dll</HintPath>
    </Reference>
    <Reference Include="ModInstaller.Adaptor.Dynamic">
      <HintPath>$(FomodInstallerDir)/ModInstaller.Adaptor.Dynamic.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
